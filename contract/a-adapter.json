{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A adapter c-1",
  "type": "object",
  "required": [
    "op"
  ],
  "properties": {
    "op": {
      "enum": [
        "snapshot",
        "telemetry",
        "lookup",
        "commit"
      ]
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "machine_id": {
      "type": "string"
    },
    "request": {},
    "result": {},
    "expected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "version"
        ],
        "properties": {
          "kind": {
            "enum": [
              "machines",
              "incidents",
              "technicians",
              "inventory",
              "alerts"
            ]
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "value"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "commit"
          }
        }
      },
      "then": {
        "required": [
          "command_id",
          "request",
          "expected",
          "changes",
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "lookup"
          }
        }
      },
      "then": {
        "required": [
          "command_id",
          "request"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "telemetry"
          }
        }
      },
      "then": {
        "required": [
          "machine_id"
        ]
      }
    }
  ]
}